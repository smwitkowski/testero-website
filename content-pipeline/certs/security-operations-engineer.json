          "subsections": [
            {
              "id": "security-operations-engineer:standard:4.1",
              "number": "4.1",
              "title": "Developing and implementing mechanisms to detect risks and identify threats.",
              "weight_percent": null,
              "objectives": [
                {
                  "id": "security-operations-engineer:standard:4.1:1",
                  "text": "Reconciling threat intelligence with user and asset activity",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:2",
                  "text": "Analyzing logs and events to identify anomalous activity",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:3",
                  "text": "Assessing suspicious behavior patterns by using detection rules and searches across various timelines",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:4",
                  "text": "Designing detection rules that use risk values (e.g., Google SecOps reference lists) to identify threats matching risk profiles",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:5",
                  "text": "Discovering anomalous behavior of assets or users, and assigning risk values to the detections (e.g., Google SecOps Risk Analytics, curated detection rules)",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:6",
                  "text": "Designing detection rules to discover posture or risk profile changes within the environment (e.g., SCC Security Health Analytics [SHA], SCC posture management, Google SecOps)",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:7",
                  "text": "Identifying new or low prevalence processes, domains, and IP addresses that do not appear in threat intelligence sources using various methods (e.g., writing YARA-L rules, dashboards)",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:8",
                  "text": "Assessing how to use entity/context data within detection rules to improve their accuracy (e.g., Google SecOps entity graph)",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:4.1:9",
                  "text": "Configuring SCC Event Threat Detection custom detectors for IOCs",
                  "children": []
                }
              ]
            },
