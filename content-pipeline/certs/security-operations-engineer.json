        {
          "id": "security-operations-engineer:standard:1",
          "number": "1",
          "title": "Platform operations",
          "weight_percent": 14.0,
          "weight_approximate": true,
          "included": true,
          "subsections": [
            {
              "id": "security-operations-engineer:standard:1.1",
              "number": "1.1",
              "title": "Enhancing detection and response.",
              "weight_percent": null,
              "objectives": [
                {
                  "id": "security-operations-engineer:standard:1.1:1",
                  "text": "Prioritizing telemetry sources (e.g., Security Command Center [SCC], Google Security Operations [SecOps], GTI, Cloud IDS) to detect incidents or misconfigurations within an enterprise environment",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.1:2",
                  "text": "Integrating multiple tools (e.g., SCC, Google SecOps, GTI, Cloud IDS, downstream third-party system) in the security architecture to enhance detection capabilities",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.1:3",
                  "text": "Justifying the use of tools with overlapping capabilities based on a set of requirements",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.1:4",
                  "text": "Evaluating the effectiveness of existing tools to identify gaps in coverage and mitigate potential threats",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.1:5",
                  "text": "Evaluating automation and cloud-based tools to enhance existing detection and response processes",
                  "children": []
                }
              ]
            },
            {
              "id": "security-operations-engineer:standard:1.2",
              "number": "1.2",
              "title": "Configuring access.",
              "weight_percent": null,
              "objectives": [
                {
                  "id": "security-operations-engineer:standard:1.2:1",
                  "text": "Configuring user and service account authentication to security tools (e.g., SCC, Google SecOps)",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.2:2",
                  "text": "Configuring user and service account authorization for feature access using IAM roles and permissions",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.2:3",
                  "text": "Configuring user and service account authorization for data access using IAM roles and permissions",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.2:4",
                  "text": "Configuring and analyzing audit logs (e.g., Cloud Audit Logs, data access logs) for the solution",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.2:5",
                  "text": "Configuring API access for automations within security tools (e.g., service accounts, API keys, SCC, Google SecOps, GTI)",
                  "children": []
                },
                {
                  "id": "security-operations-engineer:standard:1.2:6",
                  "text": "Provisioning identities using Workforce Identity Federation",
                  "children": []
                }
              ]
