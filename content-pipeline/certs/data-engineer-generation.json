{
  "schema_version": 1,
  "version": "pde-v1",
  "cert_id": "data-engineer",
  "required_topics": [
    {
      "id": "dataflow-streaming",
      "label": "Dataflow streaming windows, triggers and late data",
      "objective_ids": [
        "data-engineer:standard:2.2:3:2"
      ],
      "guidance": "Test a streaming window, trigger or late-data decision in Dataflow. Keep the streaming transformation objective central."
    },
    {
      "id": "storage-choice",
      "label": "Bigtable vs Spanner vs BigQuery storage choice",
      "objective_ids": [
        "data-engineer:standard:3.1:2"
      ],
      "guidance": "Choose storage from Bigtable, Spanner and BigQuery using access patterns and managed-service tradeoffs."
    },
    {
      "id": "dataplex-governance",
      "label": "Dataplex governance",
      "objective_ids": [
        "data-engineer:standard:3.4:1"
      ],
      "guidance": "Test a Dataplex data-platform governance decision within the selected guide objective."
    },
    {
      "id": "datastream-replication",
      "label": "Datastream replication",
      "objective_ids": [
        "data-engineer:standard:1.4:2"
      ],
      "guidance": "Test Datastream replication as a migration and validation decision, not unrelated database administration."
    },
    {
      "id": "sensitive-data-masking",
      "label": "Sensitive Data Protection / masking",
      "objective_ids": [
        "data-engineer:standard:4.1:5"
      ],
      "guidance": "Test sensitive-data protection or data masking. Use the guide name Cloud Data Loss Prevention (Cloud DLP) where naming that service."
    },
    {
      "id": "analytics-hub-sharing",
      "label": "Analytics Hub sharing",
      "objective_ids": [
        "data-engineer:standard:4.3:4"
      ],
      "guidance": "Test a dataset-sharing decision using BigQuery sharing (Analytics Hub)."
    },
    {
      "id": "dataproc-vs-dataflow",
      "label": "Dataproc vs Dataflow",
      "objective_ids": [
        "data-engineer:standard:2.2:2"
      ],
      "guidance": "Choose Dataproc or Dataflow using the pipeline workload and processing model."
    },
    {
      "id": "composer-orchestration",
      "label": "Composer orchestration",
      "objective_ids": [
        "data-engineer:standard:5.2:1"
      ],
      "guidance": "Test DAG orchestration in Cloud Composer within the selected automation objective."
    },
    {
      "id": "ml-embedding-prep",
      "label": "ML / embedding data preparation",
      "objective_ids": [
        "data-engineer:standard:4.2:1",
        "data-engineer:standard:4.2:2"
      ],
      "guidance": "Test data preparation for ML features or embeddings. Keep the selected objective central; do not introduce model-training decisions outside it."
    }
  ],
