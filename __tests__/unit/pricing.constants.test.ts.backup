// Inactive backup retained intentionally. The current offer is PMLE Pass only.
import * as pricing from "@/lib/pricing/constants";
import { getPassAnalyticsProperties } from "@/lib/pricing/price-utils";

describe("PMLE Pass pricing", () => {
  it("uses the single founder-approved offer", () => {
    expect(pricing.PMLE_PASS).toMatchObject({
      name: "PMLE Pass", price: 39, durationDays: 90, refundDays: 7,
    });
  });
  it("has no subscription tiers or exam packages", () => {
    expect(pricing).not.toHaveProperty("SUBSCRIPTION_TIERS");
    expect(pricing).not.toHaveProperty("EXAM_PACKAGES");
  });
  it("uses the same name and payment mode in analytics", () => {
    expect(getPassAnalyticsProperties()).toMatchObject({
      plan_name: "PMLE Pass", payment_mode: "payment",
    });
  });
});
