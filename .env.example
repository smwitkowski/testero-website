# Local placeholders only. Get generated local values from `supabase status -o json`.
# Supply credentials through process environment. Do not commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56541
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-placeholder
# Empty PostHog values disable analytics. Public values are compiled at build time.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Server-only Stripe values. Use matching test/live mode product and endpoint.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PMLE_PASS=price_placeholder
# TESTERO_LOCAL_STRIPE is a test-only runner flag. Never set it in production.
# NODE_ENV is set by Next.js/the deployment platform; it is not a user secret.
