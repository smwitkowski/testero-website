// Inactive backup retained intentionally. Stripe services must be mocked if restored.
import { test, expect } from "@playwright/test";

test.describe("PMLE Pass pricing", () => {
  test("shows the one-time offer and refund policy", async ({ page }) => {
    await page.goto("/pricing");
    await expect(page.getByRole("button", { name: "Get PMLE Pass" })).toHaveCount(1);
    await expect(page.getByText("PMLE Pass", { exact: true }).first()).toBeVisible();
    await expect(page.getByText("$39", { exact: true })).toBeVisible();
    await expect(page.getByText(/90 days/i).first()).toBeVisible();
    await expect(page.getByText(/7-day refund/i).first()).toBeVisible();
  });
  test("requires an account before checkout", async ({ page }) => {
    await page.goto("/pricing");
    await page.getByRole("button", { name: "Get PMLE Pass" }).click();
    await expect(page).toHaveURL(/\/signup/);
  });
});
